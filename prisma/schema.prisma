generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CONSULTANT
  ADMIN
}

enum AnalysisStatus {
  PENDING
  READY
  NEEDS_REVIEW
  APPROVED
}

enum SimulationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum SimulationType {
  COLOR_DRAPE
  BLOUSE_TONE
}

enum FeedbackKind {
  HELPED
  DID_NOT_HELP
}

/// Status da thread do desk externo (consultora).
enum DeskThreadStatus {
  OPEN
  WAITING
  CLOSED
}

enum DeskReviewStatus {
  PENDING
  REPORT_SENT
  CLOSED
}

enum DeskMessageRole {
  CLIENT
  CONSULTANT
  SYSTEM
}

/// Produto cobrado via Asaas (lançamento).
enum PaymentSku {
  ANALYSIS
  REVIEW
}

enum PaymentOrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  EXPIRED
  REFUNDED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(USER)
  /// Foto de perfil (caminho relativo em uploads/, ex. userId/avatar-….jpg)
  avatarPath    String?
  /// Data de nascimento — idade calculada na UI
  birthDate     DateTime?
  city          String?
  /// UF brasileira (2 letras) ou região
  state         String?
  /// Bio / o que busca na colorimetria (visível à consultora)
  about         String?
  /// Customer id no Asaas (reuso entre cobranças).
  asaasCustomerId String?
  lgpdConsentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  analyses       Analysis[]
  reviews        ConsultantReview[] @relation("Reviewer")
  simulationJobs SimulationJob[]
  accounts       Account[]
  sessions       Session[]
  colorProfile   UserColorProfile?
  feedbackEvents FeedbackEvent[]
  analysisSamples AnalysisSample[]
  paymentOrders  PaymentOrder[]
  deskThreadsAssigned DeskThread[] @relation("DeskThreadAssignee")
  deskReviewsAssigned DeskReview[] @relation("DeskReviewAssignee")
  deskMessages        DeskMessage[] @relation("DeskMessageAuthor")
  deskTransfersFrom   DeskThreadTransfer[] @relation("DeskTransferFrom")
  deskTransfersTo     DeskThreadTransfer[] @relation("DeskTransferTo")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeasonPalette {
  id          String   @id
  namePt      String
  nameEn      String
  temperature String
  value       String
  chroma      String
  description String
  useColors   Json
  avoidColors Json
  clothing    Json
  lipstick    Json
  eyeshadow   Json
  base        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses         Analysis[]         @relation("PredictedSeason")
  overrideAnalyses Analysis[]         @relation("OverrideSeason")
  reviews          ConsultantReview[]
}

model Analysis {
  id                 String         @id @default(cuid())
  userId             String
  imagePath          String
  status             AnalysisStatus @default(PENDING)
  seasonId           String?
  overrideSeasonId   String?
  confidence         Float?
  features           Json?
  photoQuality       Json?
  undertoneLabel     String?
  recommendations    Json?
  context            String         @default("casual")
  /// Objetivos escolhidos no upload (harmonia, roupas, olheiras, …).
  goals              String[]       @default([])
  /// Intenção em texto livre (“quero valorizar o olhar”, etc.).
  intention          String?
  /// Plano da consultora IA (JSON tipado: priorities + changes).
  consultantPlan     Json?
  /// Meta da geração: modelo, usedVision, erro, etc.
  consultantPlanMeta Json?
  consultantApproved Boolean        @default(false)
  /// Provider de face usado nesta análise (heuristic|blazeface|...).
  detectorProvider   String?
  /// Preditor de estação (rules|tabular-v1|...).
  predictorId        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  season         SeasonPalette?     @relation("PredictedSeason", fields: [seasonId], references: [id])
  overrideSeason SeasonPalette?     @relation("OverrideSeason", fields: [overrideSeasonId], references: [id])
  reviews        ConsultantReview[]
  simulations    SimulationJob[]
  sample         AnalysisSample?
  feedbackEvents FeedbackEvent[]
  paymentOrders  PaymentOrder[]

  @@index([userId, createdAt])
  @@index([status])
}

/// Cobrança Asaas (1 ANALYSIS = 1 análise; 1 REVIEW = 1 pedido de revisão).
model PaymentOrder {
  id               String             @id @default(cuid())
  userId           String
  sku              PaymentSku
  amountCents      Int
  currency         String             @default("BRL")
  status           PaymentOrderStatus @default(PENDING)
  asaasPaymentId   String?            @unique
  asaasCustomerId  String?
  billingType      String?
  invoiceUrl       String?
  pixQrCode        String?            @db.Text
  pixCopyPaste     String?            @db.Text
  analysisId       String?
  paidAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([userId, sku, status])
  @@index([analysisId, sku])
  @@index([status, expiresAt])
}

/// Features canônicas versionadas para treino (Fase 2/3).
model AnalysisSample {
  id                   String   @id @default(cuid())
  analysisId           String   @unique
  userId               String
  featureSchemaVersion Int      @default(1)
  detectorProvider     String
  predictorId          String
  features             Json
  predictedSeasonId    String?
  /// Preenchido quando consultora override / feedback fecha o label.
  labelSeasonId        String?
  labelSource          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([labelSeasonId])
}

/// O que ajudou ou não para esta pessoa (Fase 2).
model FeedbackEvent {
  id         String       @id @default(cuid())
  userId     String
  analysisId String
  kind       FeedbackKind
  /// Ex.: lipstick:Coral, clothing:#FF6B35, season
  target     String
  note       String?
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([analysisId])
}

/// Calibração por pessoa (Fase 3) — bias sobre scores globais.
model UserColorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  temperatureBias    Float    @default(0)
  valueBias          Float    @default(0)
  chromaBias         Float    @default(0)
  preferredSeasonId  String?
  sampleCount        Int      @default(0)
  lastCalibratedAt   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Artefato de modelo treinado (Fase 3).
model ModelVersion {
  id          String   @id @default(cuid())
  name        String
  predictorId String   @default("tabular-v1")
  artifactPath String?
  metrics     Json?
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([predictorId, active])
}

model ConsultantReview {
  id               String   @id @default(cuid())
  analysisId       String
  reviewerId       String
  overrideSeasonId String?
  notes            String?
  approved         Boolean  @default(true)
  createdAt        DateTime @default(now())

  analysis       Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  reviewer       User           @relation("Reviewer", fields: [reviewerId], references: [id])
  overrideSeason SeasonPalette? @relation(fields: [overrideSeasonId], references: [id])

  @@index([analysisId])
}

model SimulationJob {
  id             String           @id @default(cuid())
  userId         String
  analysisId     String
  type           SimulationType
  targetColorHex String
  status         SimulationStatus @default(QUEUED)
  provider       String           @default("mock")
  providerJobId  String?
  inputPath      String
  outputPath     String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

/// Avaliação na fila do desk externo (persistida — não apagar threads).
model DeskReview {
  id                   String           @id @default(cuid())
  analysisId           String
  clientLabel          String
  seasonName           String?
  status               DeskReviewStatus @default(PENDING)
  autoReport           Json
  assignedConsultantId String?
  reportSentAt         DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  assignedConsultant User?       @relation("DeskReviewAssignee", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  thread             DeskThread?

  @@index([status, createdAt])
  @@index([assignedConsultantId])
}

/// Conversa do desk. Nunca hard-delete: use archivedAt.
model DeskThread {
  id                   String           @id @default(cuid())
  analysisId           String
  reviewId             String           @unique
  clientLabel          String
  status               DeskThreadStatus @default(OPEN)
  assignedConsultantId String?
  unreadForConsultant  Int              @default(0)
  lastMessageAt        DateTime?
  /// Arquivada some da lista ativa; histórico permanece.
  archivedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  review             DeskReview           @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  assignedConsultant User?                @relation("DeskThreadAssignee", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  messages           DeskMessage[]
  transfers          DeskThreadTransfer[]

  @@index([assignedConsultantId, archivedAt])
  @@index([status, archivedAt])
  @@index([unreadForConsultant, archivedAt])
}

model DeskMessage {
  id            String          @id @default(cuid())
  threadId      String
  role          DeskMessageRole
  body          String
  attachments   Json?
  externalLinks Json?
  authorId      String?
  createdAt     DateTime        @default(now())

  thread DeskThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  author User?      @relation("DeskMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

/// Histórico de encaminhamento entre consultoras.
model DeskThreadTransfer {
  id               String   @id @default(cuid())
  threadId         String
  fromConsultantId String?
  toConsultantId   String
  note             String?
  createdAt        DateTime @default(now())

  thread DeskThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  from   User?      @relation("DeskTransferFrom", fields: [fromConsultantId], references: [id], onDelete: SetNull)
  to     User       @relation("DeskTransferTo", fields: [toConsultantId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@index([toConsultantId])
}
