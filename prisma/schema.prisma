generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CONSULTANT
  ADMIN
}

enum AnalysisStatus {
  PENDING
  READY
  NEEDS_REVIEW
  APPROVED
}

enum SimulationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum SimulationType {
  COLOR_DRAPE
  BLOUSE_TONE
}

enum FeedbackKind {
  HELPED
  DID_NOT_HELP
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(USER)
  lgpdConsentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  analyses       Analysis[]
  reviews        ConsultantReview[] @relation("Reviewer")
  simulationJobs SimulationJob[]
  accounts       Account[]
  sessions       Session[]
  colorProfile   UserColorProfile?
  feedbackEvents FeedbackEvent[]
  analysisSamples AnalysisSample[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeasonPalette {
  id          String   @id
  namePt      String
  nameEn      String
  temperature String
  value       String
  chroma      String
  description String
  useColors   Json
  avoidColors Json
  clothing    Json
  lipstick    Json
  eyeshadow   Json
  base        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses         Analysis[]         @relation("PredictedSeason")
  overrideAnalyses Analysis[]         @relation("OverrideSeason")
  reviews          ConsultantReview[]
}

model Analysis {
  id                 String         @id @default(cuid())
  userId             String
  imagePath          String
  status             AnalysisStatus @default(PENDING)
  seasonId           String?
  overrideSeasonId   String?
  confidence         Float?
  /// P0.3: Breakdown de confiança por eixo (temp, value, chroma, contrast)
  confidenceBreakdown Json?
  features           Json?
  photoQuality       Json?
  undertoneLabel     String?
  recommendations    Json?
  context            String         @default("casual")
  /// Objetivos escolhidos no upload (harmonia, roupas, olheiras, …).
  goals              String[]       @default([])
  /// Intenção em texto livre (“quero valorizar o olhar”, etc.).
  intention          String?
  /// Plano da consultora IA (JSON tipado: priorities + changes).
  consultantPlan     Json?
  /// Meta da geração: modelo, usedVision, erro, etc.
  consultantPlanMeta Json?
  consultantApproved Boolean        @default(false)
  /// Provider de face usado nesta análise (heuristic|blazeface|...).
  detectorProvider   String?
  /// Preditor de estação (rules|tabular-v1|...).
  predictorId        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  season         SeasonPalette?     @relation("PredictedSeason", fields: [seasonId], references: [id])
  overrideSeason SeasonPalette?     @relation("OverrideSeason", fields: [overrideSeasonId], references: [id])
  reviews        ConsultantReview[]
  simulations    SimulationJob[]
  sample         AnalysisSample?
  feedbackEvents FeedbackEvent[]
  entitlement    AnalysisEntitlement?

  @@index([userId, createdAt])
  @@index([status])
}

/// Entitlement para resultado completo (confidence + axes + palette)
model AnalysisEntitlement {
  id              String   @id @default(cuid())
  analysisId      String   @unique
  userId          String
  /// SKU: "resultado-completo" (R$97 provisional)
  sku             String   @default("resultado-completo")
  /// Payment provider reference (Stripe payment intent, etc.)
  paymentRef      String?
  /// Payment status: "pending" | "completed" | "failed"
  paymentStatus   String   @default("pending")
  /// Price paid in cents (9700 = R$97.00)
  priceCents      Int      @default(9700)
  grantedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([paymentStatus])
}

/// Features canônicas versionadas para treino (Fase 2/3).
model AnalysisSample {
  id                   String   @id @default(cuid())
  analysisId           String   @unique
  userId               String
  featureSchemaVersion Int      @default(1)
  detectorProvider     String
  predictorId          String
  features             Json
  predictedSeasonId    String?
  /// Preenchido quando consultora override / feedback fecha o label.
  labelSeasonId        String?
  labelSource          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([labelSeasonId])
}

/// O que ajudou ou não para esta pessoa (Fase 2).
model FeedbackEvent {
  id         String       @id @default(cuid())
  userId     String
  analysisId String
  kind       FeedbackKind
  /// Ex.: lipstick:Coral, clothing:#FF6B35, season
  target     String
  note       String?
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([analysisId])
}

/// Calibração por pessoa (Fase 3) — bias sobre scores globais.
model UserColorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  temperatureBias    Float    @default(0)
  valueBias          Float    @default(0)
  chromaBias         Float    @default(0)
  preferredSeasonId  String?
  sampleCount        Int      @default(0)
  lastCalibratedAt   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Artefato de modelo treinado (Fase 3).
model ModelVersion {
  id          String   @id @default(cuid())
  name        String
  predictorId String   @default("tabular-v1")
  artifactPath String?
  metrics     Json?
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([predictorId, active])
}

model ConsultantReview {
  id               String   @id @default(cuid())
  analysisId       String
  reviewerId       String
  overrideSeasonId String?
  notes            String?
  approved         Boolean  @default(true)
  createdAt        DateTime @default(now())

  analysis       Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  reviewer       User           @relation("Reviewer", fields: [reviewerId], references: [id])
  overrideSeason SeasonPalette? @relation(fields: [overrideSeasonId], references: [id])

  @@index([analysisId])
}

model SimulationJob {
  id             String           @id @default(cuid())
  userId         String
  analysisId     String
  type           SimulationType
  targetColorHex String
  status         SimulationStatus @default(QUEUED)
  provider       String           @default("mock")
  providerJobId  String?
  inputPath      String
  outputPath     String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}
