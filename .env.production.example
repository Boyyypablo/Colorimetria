# Copie para .env.production na VPS (nunca commitar).
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# URL pública do site (IP ou domínio com https)
AUTH_URL="http://SEU_IP_OU_DOMINIO:3000"
# openssl rand -base64 32
AUTH_SECRET="troque-por-segredo-longo-e-aleatorio"

POSTGRES_USER="colometria"
POSTGRES_PASSWORD="troque-por-senha-forte"
POSTGRES_DB="colometria"
# Nunca criar admin/consultora demo neste banco
ALLOW_DEMO_SEED="false"

# Porta publicada no host (firewall: liberar só esta)
APP_PORT=3000

VTO_PROVIDER="huggingface"
HF_TOKEN=""
VTO_DAILY_LIMIT="5"
VTO_UNLIMITED_EMAILS=""

FACE_DETECTOR="blazeface"
COLOR_PREDICTOR="rules"
PHOTO_RETENTION_DAYS="365"

# Consultora: cards (gratuito, igual ao que a usuária vê no Vercel) | ollama no PC
# gemini só se no futuro houver orçamento
CONSULTANT_AI="cards"

