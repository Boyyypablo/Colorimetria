# Supabase Postgres (servidor only — sem Data API no browser)
# docs/architecture/supabase.md
DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_URL="https://[REF].supabase.co"

# Auth.js — openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"
AUTH_URL="http://localhost:3000"

UPLOAD_DIR="uploads"

CONSULTANT_AI="none"
FACE_DETECTOR="blazeface"
COLOR_PREDICTOR="rules"
PHOTO_RETENTION_DAYS="365"

VTO_PROVIDER="mock"
VTO_DAILY_LIMIT="5"

# true só se quiser seed de contas demo (nunca em produção real)
ALLOW_DEMO_SEED="false"

# Pagamentos Asaas (docs/architecture/payments-asaas.md)
PAYMENTS_ENABLED="false"
